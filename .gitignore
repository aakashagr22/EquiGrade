# ══════════════════════════════════════════
# EquiGrade — .gitignore
# ══════════════════════════════════════════

# ── Environment & Secrets ────────────────
.env
.env.*
!.env.example
!.env.local.example
*.pem

# ── Python ───────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
*.egg
.pytest_cache/
.coverage
htmlcov/
*.so

# ── Node / Frontend ─────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ──────────────────────────────
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ── Vercel ───────────────────────────────
.vercel

# ── Testing ──────────────────────────────
coverage/

# ── IDE ──────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────
.DS_Store
Thumbs.db

# ── Debug Logs ───────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── Docker ───────────────────────────────
docker-compose.override.yml

# ── Misc ─────────────────────────────────
*.bak
*.tmp
*.cache
